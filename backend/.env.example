DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/Knowflow
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=knowflow-documents
MAX_UPLOAD_SIZE_MB=20
# Optional — only needed for the document summarization feature.
# Leave blank if you're not testing that specific feature.
ANTHROPIC_API_KEY=